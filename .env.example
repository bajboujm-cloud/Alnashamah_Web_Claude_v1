# Copy this file to `.env.local` (cp .env.example .env.local). `.env.local` is never committed.
# With Docker running, the defaults below work as-is on your laptop — no accounts needed.

# --- Site ---------------------------------------------------------------
# Public URL of the site (used for SEO links). Production: https://alnashamah.ae
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
# Local: the Postgres container from docker-compose.yml (port 5433).
# Production (later): the Neon connection string (pooled), set in Vercel.
DATABASE_URL=postgres://nashamah:nashamah@localhost:5433/nashamah

# --- Admin sign-in -------------------------------------------------------
# Secret used to protect staff sign-in data. Optional on your laptop (a built-in development value is
# used); REQUIRED in production — generate one with:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Folder for uploaded photos on your laptop (Vercel Blob is used in production later).
STORAGE_DIR=.storage

# --- Customer sign-in (mobile number + one-time code) -------------------
# "console" (laptop): the code is printed in the terminal where `pnpm dev` runs, and shown on the
# sign-in screen while developing. "twilio" (go-live): real SMS through Twilio Verify — then also fill
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and TWILIO_VERIFY_SERVICE_SID.
OTP_PROVIDER=console
# Also show the code on screen after `pnpm build && pnpm start` (console provider only). Never in production.
OTP_SHOW_CODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# How many codes one internet address (IP) may ask for per hour.
OTP_IP_LIMIT_PER_HOUR=30

# Bot check before sending a code (Cloudflare Turnstile). Empty = no bot check (laptop).
# Free test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# Real keys (free) at go-live: https://dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Map pin for the delivery address -----------------------------------
# Empty = the free OpenStreetMap map (fine on your laptop). Go-live: a Google Maps "Maps JavaScript API"
# key (Google Cloud console → APIs & Services; restrict it to https://alnashamah.ae/*) and, optionally, a
# Map ID. Customers then see Google Maps with satellite view. Pins always open in Google Maps for drivers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Contact (optional) -------------------------------------------------
# WhatsApp number in international format without "+" (e.g. 9715XXXXXXXX).
# Leave empty to hide the WhatsApp button.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Coming in later phases (leave empty for now) -----------------------
# Go-live  file storage:  BLOB_READ_WRITE_TOKEN=  (Vercel Blob)
# Phase 5  email:         EMAIL_PROVIDER=smtp | resend, SMTP_URL=smtp://localhost:1025, RESEND_API_KEY=
# Phase 5  payments:      PAYMENT_PROVIDER=mock | stripe, STRIPE_SECRET_KEY=, STRIPE_WEBHOOK_SECRET=
